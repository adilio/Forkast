{
  "name": "forkast",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "og": "node scripts/render-og.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --project forkast-4dl --only firestore \"npm run test:rules:unit\"",
    "test:rules:unit": "vitest run --config vitest.rules.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test && npm run build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "entities": "^7.0.1",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.10.0",
    "ipaddr.js": "^2.4.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@netlify/functions": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.9",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "firebase-tools": "^15.25.1",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "gaxios": {
      "uuid": "^14.0.1"
    },
    "google-gax": {
      "uuid": "^14.0.1"
    },
    "teeny-request": {
      "uuid": "^14.0.1"
    }
  }
}
