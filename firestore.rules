rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(householdId) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }
    function only(fields) { return request.resource.data.keys().hasOnly(fields); }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /households/{householdId} {
      allow read: if member(householdId);
      allow write: if false;

      match /members/{uid} {
        allow read: if member(householdId);
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read, write: if false;
      }

      // Any member may shape the store list. Which shops a household uses is
      // not an owner's decision to make on everyone's behalf, and a household
      // stuck with the two it was seeded with was the original complaint.
      match /stores/{storeId} {
        allow read: if member(householdId);
        function validStore() {
          return only(['name','sortOrder','createdAt','createdBy','updatedAt','updatedBy'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.sortOrder is number
          && request.resource.data.updatedBy == request.auth.uid;
        }
        allow create: if member(householdId)
          && validStore()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(householdId) && validStore();
        // Shopping items pointing at a deleted store would be invisible on the
        // list and, because every item write checks its store exists, no longer
        // editable either. The client moves them first; see deleteStore.
        allow delete: if member(householdId);
      }

      match /recipes/{recipeId} {
        allow read: if member(householdId);
        function validRecipe() {
          return only(['title','description','sourceUrl','sourceHost','imageUrl','baseServings','ingredients','instructions','notes','tags','starred','importMetadata','createdAt','createdBy','updatedAt','updatedBy'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 300
          && request.resource.data.ingredients is list
          && request.resource.data.ingredients.size() <= 500
          && request.resource.data.instructions is list
          && request.resource.data.createdBy is string
          && request.resource.data.updatedBy == request.auth.uid;
        }
        allow create: if member(householdId)
          && validRecipe()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(householdId)
          && validRecipe()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if member(householdId);
      }

      // The pre-split household baseline. Still readable so nobody's existing
      // routing was discarded, but no longer writable from the client: every
      // new rule belongs to one person, under memberPrefs below.
      match /ingredientStoreRules/{ingredientKey} {
        allow read: if member(householdId);
        allow write: if false;
      }

      // One person's shopping habits. Any member may read them — the household
      // shares a list and seeing why an ingredient routed somewhere is useful —
      // but only their owner may write them.
      match /memberPrefs/{memberUid} {
        allow read: if member(householdId);
        allow create, update: if member(householdId)
          && request.auth.uid == memberUid
          && only(['defaultStoreId','updatedAt','updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && exists(/databases/$(database)/documents/households/$(householdId)/stores/$(request.resource.data.defaultStoreId));
        allow delete: if false;

        match /storeRules/{ingredientKey} {
          allow read: if member(householdId);
          allow create, update: if member(householdId)
            && request.auth.uid == memberUid
            && only(['displayName','storeId','updatedAt','updatedBy'])
            && request.resource.data.updatedBy == request.auth.uid
            && exists(/databases/$(database)/documents/households/$(householdId)/stores/$(request.resource.data.storeId));
          allow delete: if member(householdId) && request.auth.uid == memberUid;
        }
      }

      // The week's plan. `date` is validated as a plain YYYY-MM-DD string
      // rather than a timestamp: a household calendar's Tuesday must not
      // depend on which time zone the reader is in.
      //
      // recipeId is deliberately NOT checked against an existing recipe. A
      // recipe someone deletes would otherwise freeze every meal that named
      // it — no write to that meal could pass again, including the one that
      // corrects it — so the plan screen tolerates a missing recipe instead.
      match /plannedMeals/{plannedMealId} {
        allow read: if member(householdId);
        function validPlannedMeal() {
          return only(['date','slot','recipeId','servings','note','createdAt','createdBy','updatedAt','updatedBy'])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.slot in ['breakfast','lunch','dinner','other']
          && request.resource.data.recipeId is string
          && request.resource.data.recipeId.size() > 0
          && (request.resource.data.servings == null
              || (request.resource.data.servings is number
                  && request.resource.data.servings > 0
                  && request.resource.data.servings <= 100))
          && request.resource.data.updatedBy == request.auth.uid;
        }
        allow create: if member(householdId)
          && validPlannedMeal()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(householdId)
          && validPlannedMeal()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if member(householdId);
      }

      match /shoppingItems/{itemId} {
        allow read: if member(householdId);
        function validShoppingItem() {
          return only(['name','normalizedName','quantity','quantityMax','unit','note','storeId','checked','manual','sourceRecipeId','sourceIngredientId','createdAt','createdBy','updatedAt','updatedBy'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 300
          && request.resource.data.checked is bool
          && request.resource.data.updatedBy == request.auth.uid
          && exists(/databases/$(database)/documents/households/$(householdId)/stores/$(request.resource.data.storeId));
        }
        allow create: if member(householdId)
          && validShoppingItem()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(householdId)
          && validShoppingItem()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if member(householdId);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
