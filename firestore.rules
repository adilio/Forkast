rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(householdId) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }
    function only(fields) { return request.resource.data.keys().hasOnly(fields); }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /households/{householdId} {
      allow read: if member(householdId);
      allow write: if false;

      match /members/{uid} {
        allow read: if member(householdId);
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read, write: if false;
      }

      match /stores/{storeId} {
        allow read: if member(householdId);
        allow write: if false;
      }

      match /recipes/{recipeId} {
        allow read: if member(householdId);
        function validRecipe() {
          return only(['title','description','sourceUrl','sourceHost','imageUrl','baseServings','ingredients','instructions','notes','tags','starred','importMetadata','createdAt','createdBy','updatedAt','updatedBy'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 300
          && request.resource.data.ingredients is list
          && request.resource.data.ingredients.size() <= 500
          && request.resource.data.instructions is list
          && request.resource.data.createdBy is string
          && request.resource.data.updatedBy == request.auth.uid;
        }
        allow create: if member(householdId)
          && validRecipe()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(householdId)
          && validRecipe()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if member(householdId);
      }

      match /ingredientStoreRules/{ingredientKey} {
        allow read: if member(householdId);
        allow create, update: if member(householdId)
          && only(['displayName','storeId','updatedAt','updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && exists(/databases/$(database)/documents/households/$(householdId)/stores/$(request.resource.data.storeId));
        allow delete: if member(householdId);
      }

      match /shoppingItems/{itemId} {
        allow read: if member(householdId);
        function validShoppingItem() {
          return only(['name','normalizedName','quantity','quantityMax','unit','note','storeId','checked','manual','sourceRecipeId','sourceIngredientId','createdAt','createdBy','updatedAt','updatedBy'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 300
          && request.resource.data.checked is bool
          && request.resource.data.updatedBy == request.auth.uid
          && exists(/databases/$(database)/documents/households/$(householdId)/stores/$(request.resource.data.storeId));
        }
        allow create: if member(householdId)
          && validShoppingItem()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(householdId)
          && validShoppingItem()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if member(householdId);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
